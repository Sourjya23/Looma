# ══════════════════════════════════════════════════════════
# Looma — Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env files with real secrets!
# ══════════════════════════════════════════════════════════

NODE_ENV=development
API_PORT=3001

# ── Database (Supabase PostgreSQL) ──
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@[YOUR_SUPABASE_HOST]:6543/postgres?pgbouncer=true"

# ── Redis (Upstash / Render) ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_BYTE_SECRET"
JWT_EXPIRES_IN="7d"

# ── CORS ──
CORS_ORIGIN="http://localhost:5174"

# ── AI API Keys ──
# Primary AI provider (Gemini recommended)
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
MODEL_NAME="gemini-2.0-flash"
GEMINI_API_KEY="your-gemini-api-key"

# Optional: Additional Gemini keys for rotation (comma-separated or numbered)
# GEMINI_API_KEYS="key1,key2,key3"
# GEMINI_API_KEY_2="your-second-key"

# Optional: Groq (fallback)
# GROQ_API_KEY="your-groq-api-key"

# Optional: OpenAI (for DALL-E 3 cover art)
# OPENAI_API_KEY="your-openai-api-key"

# ── AI Service (Legacy Python service, optional) ──
AI_SERVICE_URL="http://localhost:8000"

# ── Cloudinary (Cover Art Storage) ──
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# ── Stripe (Payments & Subscriptions) ──
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# ── Cron & Automated Maintenance ──
CRON_SECRET="your-secure-random-cron-secret"

# ── Frontend ──
VITE_API_URL=http://localhost:3001/api
